# scripts/release/macos.sh 가 읽는 이 맥 전용 설정. macos.local.env 로 복사해 채운다(gitignore — 커밋하지 않는다).
# 비밀 값 자체는 여기 두지 않는다. bws 의 비밀 ID 와 파일 경로만 둔다.

# 키체인의 Developer ID Application 인증서 이름(security find-identity -v -p codesigning)
SIGNING_IDENTITY="Developer ID Application: <이름> (<TEAM_ID>)"
# App Store Connect API 키(공증용)
NOTARY_KEY_ID="<KEY_ID>"
NOTARY_KEY_PATH="$HOME/keys/AuthKey_<KEY_ID>.p8"
# BWS_ACCESS_TOKEN 이 든 파일(export 하지 않고 읽기만 한다)
BWS_TOKEN_FILE="<bws 토큰 파일 경로>"
# bws 비밀 ID: 공증 Issuer ID, 업데이터 서명 비밀키, 그 암호
BWS_ISSUER_ID="<uuid>"
BWS_UPDATER_KEY_ID="<uuid>"
BWS_UPDATER_PW_ID="<uuid>"
